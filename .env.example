# ===========================================
# NexusERP Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# --- Application ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexuserp
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Authentication ---
JWT_SECRET=change-me-to-a-random-64-char-string-k8x2pL9mQ4wR7vN1bT6yH3jF0gA5cD8
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# --- MeiliSearch ---
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=nexuserp_meili_key

# --- Object Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexuserp

# --- Email (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexuserp.local

# --- AI Integration ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
